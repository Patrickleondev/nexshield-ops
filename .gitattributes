* text=auto eol=lf

*.md   text diff=markdown
*.yml  text
*.yaml text

# Binaires — pas de fusion possible, prendre la version explicitement
*.docx binary
*.xlsx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.drawio text

# Git LFS pour les binaires lourds (activer avec : git lfs install)
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.pdf  filter=lfs diff=lfs merge=lfs -text
